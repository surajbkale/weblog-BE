# ──────────────────────────────────────────────────────────────────────────────
# .env.example  —  copy this to .env.local and fill in real values
# NEVER commit .env or .env.local to git
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/blog
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=replace_with_64_byte_base64_encoded_secret

# OAuth2 — Google
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth2 — GitHub
# https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Mail (SMTP) — use Mailtrap for dev
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@weblogs.com

# Frontend URL (used for CORS + email links)
FRONTEND_URL=http://localhost:3000

# Rate limiting (optional — defaults set in application.yml)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60

# Cloudinary (image uploads)
# https://cloudinary.com/console → Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
